# Copy to .env (or set these in your host's dashboard). Never commit the real .env file.
PORT=3000
# Where the SQLite database file lives. On a host, point this at a persistent disk/volume.
DB_PATH=data/pos.db
# First start only: if the database has no users, this admin account is created.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-password
# Minutes of inactivity before a cashier is signed out.
SESSION_IDLE_MINUTES=240
# auto = add the Secure flag when the request came through HTTPS (X-Forwarded-Proto), true/false to force.
COOKIE_SECURE=auto
# Weights above this many kilograms ask the cashier to confirm.
LARGE_WEIGHT_KG=50
