# Copy to .env (or set these in your host's dashboard). Never commit the real .env file.
PORT=3000
# Which address to listen on. Leave empty in the shop (all devices on the Wi-Fi can reach it). On a host behind Caddy use 127.0.0.1.
HOST=
# Where the SQLite database file lives. On a host, point this at a persistent disk/volume.
DB_PATH=data/pos.db
# First start only: if the database has no users, this admin account is created.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-password
# Minutes of inactivity before a cashier is signed out.
SESSION_IDLE_MINUTES=240
# auto = add the Secure flag when the request came through HTTPS (X-Forwarded-Proto), true/false to force.
COOKIE_SECURE=auto
# Weights above this many kilograms ask the cashier to confirm.
LARGE_WEIGHT_KG=50
# Set to 1 ONLY when the app runs behind your own web server (Caddy) on a host. Then each visitor's real address is used for the
# sign-in limit. Leave it 0 (or empty) otherwise, so nobody can fake an address.
TRUST_PROXY=0
# On a host also set COOKIE_SECURE=true and TZ=Asia/Manila (so the business day changes at midnight in the Philippines).
